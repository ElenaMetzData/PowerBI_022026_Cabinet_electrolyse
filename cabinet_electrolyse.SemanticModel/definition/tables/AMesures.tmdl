		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

	measure 'CA RDV attendus (non planifiés)' =
			
			
			VAR Pivot = [Date Pivot (mois terminé)]
			VAR d = MAX(Calendrier[Date])
			
			VAR CAMoyMensuel =
			    CALCULATE(
			        DIVIDE([CA], 12),
			        DATESINPERIOD(Calendrier[Date], Pivot, -12, MONTH),
			        ALL(Calendrier)
			    )
			
			VAR NewAvg = [Nouveaux clients - moy / mois (12M)]
			VAR CAParClient =
			    CALCULATE(
			        [CA moyen mensuel par client (réalisé)],
			        DATESINPERIOD(Calendrier[Date], Pivot, -12, MONTH),
			        ALL(Calendrier)
			    )
			VAR N = MAX(0, DATEDIFF(EOMONTH(Pivot, 0), EOMONTH(d, 0), MONTH))
			VAR CANouveauxClients = NewAvg * CAParClient * N
			VAR Saison = [Facteur saisonnalité (mois)]
			VAR CAProjete = (CAMoyMensuel + CANouveauxClients) * Saison
			VAR CACale = [CA RDV planifiés]
			
			RETURN
			MAX(0, CAProjete - CACale)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 1c438faa-6138-4cc0-a747-90956f5c3662

		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

