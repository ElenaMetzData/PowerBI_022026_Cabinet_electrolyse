	measure 'CA par heure réalisée (12M)' =
			
			
			VAR Pivot = [Date Pivot (mois terminé)]
			VAR Heures = [Heures RDV réalisés - 12M]
			VAR CA =
			    CALCULATE(
			        [CA],
			        DATESINPERIOD(Calendrier[Date], Pivot, -12, MONTH)
			    )
			RETURN
			DIVIDE(CA, Heures)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
