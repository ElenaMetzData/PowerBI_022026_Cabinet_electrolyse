			    [CA],
			    [CA RDV planifiés] + [CA RDV attendus (non planifiés)]
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: 1a075ec8-273b-4ae1-96bd-8a7315cf5bed

