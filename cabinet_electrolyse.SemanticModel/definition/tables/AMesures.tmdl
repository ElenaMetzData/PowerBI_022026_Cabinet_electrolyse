	/// Chiffre d'affaire du dernier mois civil terminé 1 an plus tôt
	measure 'CA M-1 N-1' =
			
			VAR EndDate   = EOMONTH(TODAY(), -13)
			VAR StartDate = DATE(YEAR(EndDate), MONTH(EndDate), 1)
			RETURN
			CALCULATE(
