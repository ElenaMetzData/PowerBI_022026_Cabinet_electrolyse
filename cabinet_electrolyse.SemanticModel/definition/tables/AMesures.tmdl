	measure 'CA RDV planifiés' =
			
			
			VAR Pivot = [Date Pivot (mois terminé)]
			RETURN
			CALCULATE(
			    SUM(planity_rdv_36_mois[montant_recu_eur]),
			    planity_rdv_36_mois[date] > Pivot,
			    planity_rdv_36_mois[statut] = "planifié"
			)
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
